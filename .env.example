# ============================================================
# Cohere
# ============================================================
COHERE_API_KEY=your_cohere_api_key_here
# Modelos de chat recomendados (Cohere SDK v5+):
# - command-r7b-12-2024    (padrao; leve, bom para RAG, menor consumo de cota)
# - command-r-08-2024      (qualidade superior ao r7b, consome mais)
# - command-r-plus-08-2024 (maior qualidade / throughput)
# - command-a-03-2025      (mais performatico, consome mais ainda)
COHERE_CHAT_MODEL=command-r7b-12-2024
COHERE_EMBED_MODEL=embed-multilingual-v3.0

# ============================================================
# Chunking & Indexing
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ============================================================
# Retriever
# ============================================================
RETRIEVER_TOP_K=5
RETRIEVER_SCORE_THRESHOLD=0.5

# ============================================================
# Paths
# ============================================================
DOCS_OFFICIAL_DIR=./docs/oficiais
DOCS_COMPANY_DIR=./docs/empresa
VECTOR_STORE_DIR=./data/vector_store
LOG_DIR=./data/logs

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
